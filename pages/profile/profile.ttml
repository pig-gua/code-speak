<view class="profile-page">
  <view class="profile-card">
    <open-data class="avatar avatar-open-data" type="userAvatarUrl"></open-data>
    <view class="profile-info"><open-data class="profile-name" type="userNickName"></open-data><view class="profile-id">CodeSpeak Learner</view></view><view class="profile-badge">LV.01</view>
  </view>
  <view class="profile-stats"><view><text>{{totalLearned}}</text><view>累计学习</view></view><view><text class="green">{{totalMastered}}</text><view>已经认识</view></view><view><text>{{streakDays}}</text><view>连续学习 / 天</view></view></view>
  <view class="menu-group">
    <view class="menu-item" bindtap="openLibraries"><view class="menu-symbol">FE</view><view class="menu-name">我的词库</view><view class="menu-extra">{{libraryCount}} 个词库</view><view class="menu-arrow">›</view></view>
    <view class="menu-item" bindtap="openPreferences"><view class="menu-symbol teal">SE</view><view class="menu-name">偏好词库设置</view><view class="menu-arrow">›</view></view>
  </view>
  <view class="settings-title">学习设置</view>
  <view class="menu-group">
    <view class="menu-item"><view class="menu-symbol teal">▶</view><view class="menu-name">自动播放发音</view><switch checked="{{autoplay}}" color="#2563EB" bindchange="toggleAutoplay" /></view>
    <view class="menu-item" bindtap="showPrivacy"><view class="menu-symbol">PR</view><view class="menu-name">隐私说明</view><view class="menu-arrow">›</view></view>
  </view>
  <button class="logout-button" bindtap="logout">退出登录</button><view class="version">码语 CodeSpeak · v1.0.0</view>
</view>
